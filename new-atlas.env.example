# Copy to new-atlas.env (gitignored); compose.yml requires it.
# atlas/settings.py defaults DEBUG to TRUE and SECRET_KEY to an insecure development key.
DEBUG=FALSE
SECRET_KEY=keep-it-sage
# Semicolon-separated hostnames, added to localhost and 127.0.0.1.
# Include new-atlas if scaife-viewer calls this container directly
# (NEW_ATLAS_API_URL=http://new-atlas:8082 in .env), or those requests get HTTP 400.
ALLOWED_HOSTS=new-atlas
